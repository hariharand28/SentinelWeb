# ============================================================
# SentinelWeb — .gitignore
# ============================================================

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Environment files — NEVER commit secrets
.env
.env.local

# Virtual environments
.venv/
venv/
backend/venv/

# Logs
backend/logs/

# Trained ML model artifacts (too large for git; see README for instructions)
backend/models/*.pkl

# Archive files (working backups — not needed in version control)
*.zip

# VS Code workspace settings
.vscode/

# OS metadata
.DS_Store
Thumbs.db
