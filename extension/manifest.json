{
   
  "manifest_version": 3,
  "name": "SentinelWeb - Phishing Detector",
  "version": "1.0.0",
  "description": "Detects whether the current website is legitimate or a phishing site using an AI backend.",

  "permissions": [
  "activeTab",
  "tabs",
  "storage"
],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SentinelWeb"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
  
}

